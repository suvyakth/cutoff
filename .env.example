# Free live model + studio voice: Groq. Get a key at console.groq.com -> API Keys.
# Put your key after HQ_OPENAI_KEY= in the file named ".env" (same folder as this file), save, restart the server.
# ".env" is in .gitignore. Never commit or share it.
HQ_OPENAI_BASE=https://api.groq.com/openai/v1
HQ_OPENAI_KEY=
HQ_MODEL=qwen/qwen3.8-27b
# Studio voice (text to speech). Groq's speech models need their terms accepted once in the Groq console (Playground -> Text to speech).
HQ_TTS_MODEL=canopylabs/orpheus-v1-english
HQ_TTS_VOICE=troy
